# Server Configuration
# Required before first administrator enrollment on ANY deployment.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this secret server-side, never in VITE_* or client files.
APEX_SETUP_TOKEN=
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Google Gemini AI Integration (Required for AI features: BOM builder, ITSM diagnostics, CIO copilot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot Integration (Required for mobile quote approvals and field status sync)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Payment Gateway (Razorpay/UPI Payment Links)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Indian GST Portal & E-Invoicing Gateway (NIC API)
GST_API_KEY=
GST_SELLER_GSTIN=

# Microsoft 365 / Entra ID Integration
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Restrict Telegram owner callbacks to the configured user AND chat.
# A webhook secret alone is insufficient for owner authorizations.
TELEGRAM_AUTHORIZED_USER_ID=
TELEGRAM_AUTHORIZED_CHAT_ID=
