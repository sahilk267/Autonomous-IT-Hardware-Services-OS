# Server Configuration
# Required before first administrator enrollment on ANY deployment.
# Generate locally: node -e "console.log(require('node:crypto').randomBytes(32).toString('hex'))"
# Keep this secret server-side, never in VITE_* or client files.
APEX_SETUP_TOKEN=
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000
# Optional: comma-separated EXPLICIT public origins, no wildcards or paths.
# Production requires HTTPS and trusted reverse-proxy TLS termination.
APEX_ALLOWED_ORIGINS=
# Storage selection: single = legacy private JSON, postgres = live RLS-backed DB.
# PostgreSQL supports a fixed tenant or dynamic workspace selection after session authentication.
APEX_STORAGE_MODE=single
# fixed (default): APEX_TENANT_ID required for postgres; dynamic: leave APEX_TENANT_ID unset.
# Dynamic mode requires a selected provisioned workspace UUID during login/setup.
APEX_TENANT_MODE=fixed
# Required ONLY for postgres mode. Use a dedicated non-owner, non-BYPASSRLS role.
# Configure SSL verification in your provider-approved connection string.
DATABASE_URL=
# Required for fixed postgres mode only; provisioned by scripts/postgres-admin.mjs provision.
# UUIDs submitted by unauthenticated users are routing hints, NOT authorization.
APEX_TENANT_ID=
# Offline migration/provisioning command only: never set this in the running web process.
# Set in a secured operator shell when invoking scripts/postgres-admin.mjs.
# APEX_MIGRATION_DATABASE_URL=
# REQUIRED in production: absolute private persistent directory OUTSIDE public webroot.
# Examples: /home/account/private/apex-data or C:\\ProgramData\\Apex\\data
APEX_DATA_DIR=

# Google Gemini AI Integration (Required for AI features: BOM builder, ITSM diagnostics, CIO copilot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot Integration (Required for mobile quote approvals and field status sync)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Payment Gateway (Razorpay/UPI Payment Links)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Indian GST Portal & E-Invoicing Gateway (NIC API)
GST_API_KEY=
GST_SELLER_GSTIN=

# Microsoft 365 / Entra ID Integration
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Restrict Telegram owner callbacks to the configured user AND chat.
# A webhook secret alone is insufficient for owner authorizations.
TELEGRAM_AUTHORIZED_USER_ID=
TELEGRAM_AUTHORIZED_CHAT_ID=
