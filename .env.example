# Server Configuration
PORT=3000
NODE_ENV=development
APP_URL=http://localhost:3000

# Google Gemini AI Integration (Required for AI features: BOM builder, ITSM diagnostics, CIO copilot)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Telegram Bot Integration (Required for mobile quote approvals and field status sync)
TELEGRAM_BOT_TOKEN=
TELEGRAM_WEBHOOK_SECRET=

# Payment Gateway (Razorpay/UPI Payment Links)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# Indian GST Portal & E-Invoicing Gateway (NIC API)
GST_API_KEY=
GST_SELLER_GSTIN=

# Microsoft 365 / Entra ID Integration
M365_TENANT_ID=
M365_CLIENT_ID=
M365_CLIENT_SECRET=

# Required for safe first-time admin enrollment in production (generate a long random secret)
APEX_INITIAL_SETUP_TOKEN=
# Keep false or unset in production to disable destructive workspace resets
APEX_ALLOW_PRODUCTION_RESET=false
# Required for restricted Telegram callback approvals
TELEGRAM_AUTHORIZED_USER_ID=
TELEGRAM_AUTHORIZED_CHAT_ID=

# Optional server database location (required when using an isolated test/runtime store)
APEX_DATA_FILE=
