{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx tests/zero_mock_data.test.ts",
    "smoke": "node tests/api_smoke.mjs",
    "smoke:roles": "node tests/role_access_smoke.mjs",
    "smoke:data": "node tests/data_safety_smoke.mjs",
    "backup:data": "node scripts/backup_data.mjs",
    "test:auth": "tsx tests/auth_limit.test.ts",
    "smoke:browser": "playwright test --config=playwright.config.ts",
    "preflight:customers": "node scripts/customer_migration_preflight.mjs",
    "smoke:preflight": "node tests/customer_preflight_smoke.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "@playwright/test": "1.56.1",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21"
  }
}
