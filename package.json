{
  "name": "apex-it-os-desktop",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "tsx server.ts",
    "build": "vite build && esbuild server.ts --bundle --platform=node --format=cjs --packages=external --sourcemap --outfile=dist/server.cjs",
    "start": "node dist/server.cjs",
    "preview": "vite preview",
    "clean": "rm -rf dist",
    "lint": "tsc --noEmit",
    "test": "tsx tests/zero_mock_data.test.ts && tsx --test tests/phase_k_security.test.ts && tsx --test tests/phase_l_security.test.ts && node --test tests/phase_l_backup.test.mjs && tsx --test tests/phase_l_postgres_contract.test.ts && node --test tests/phase_l_stage3_validation.test.mjs && node --test tests/phase_m_desktop_config.test.mjs && node --test tests/phase_m_hostinger_probe.test.mjs && node --test tests/phase_m_hosted_desktop.test.mjs",
    "test:postgres": "node --test tests/phase_l_rls.integration.mjs",
    "test:stage2": "node --test tests/stage2_postgres_http.integration.mjs",
    "test:stage3": "node --test tests/stage3_schema_rls.integration.mjs",
    "package:windows": "npm run build && electron-builder --win nsis --x64",
    "test:phase-m": "tsx --test tests/phase_m_dynamic_workspaces.integration.ts",
    "test:desktop-hosted": "node --test tests/phase_m_desktop_config.test.mjs tests/phase_m_hosted_desktop.test.mjs"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "lucide-react": "^0.546.0",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "vite": "^6.2.3",
    "express": "^4.21.2",
    "dotenv": "^17.2.3",
    "motion": "^12.23.24",
    "pg": "^8.13.0"
  },
  "devDependencies": {
    "@types/node": "^22.14.0",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.25.0",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.21.0",
    "typescript": "~5.8.2",
    "vite": "^6.2.3",
    "@types/express": "^4.17.21",
    "@types/pg": "^8.11.10",
    "electron": "45.3.0",
    "electron-builder": "26.18.0"
  },
  "description": "Apex IT Hardware & Services OS Windows desktop and hosted server",
  "main": "desktop/main.cjs"
}
